{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screen Recorder",
  "version": "0.1.0",
  "identifier": "com.evgeniy.screenrecorder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Screen Recorder",
        "width": 800,
        "height": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/HandBrakeCLI.exe": "HandBrakeCLI.exe",
      "resources/HandBrakeCLI-LICENSE.txt": "HandBrakeCLI-LICENSE.txt",
      "../python/whisper_worker.py": "python/whisper_worker.py",
      "../python/parakeet_worker.py": "python/parakeet_worker.py",
      "../python/requirements-common.txt": "python/requirements-common.txt",
      "../python/requirements-gpu.txt": "python/requirements-gpu.txt"
    }
  }
}
